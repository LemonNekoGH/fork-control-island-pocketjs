+/** Position an enabled virtual cursor from a host-native pointer source.
+ *  Returns false when cursor mode has not been enabled. Coordinates use the
+ *  logical PocketJS viewport, matching hitTest and setCursorPos. */
+export function setCursorPosition(x: number, y: number): boolean {
+  if (!cursor || !Number.isFinite(x) || !Number.isFinite(y)) return false;
+  const width = cursor.vw || SCREEN_W;
+  const height = cursor.vh || SCREEN_H;
+  cursor.x = Math.min(Math.max(x, 0), width - 1);
+  cursor.y = Math.min(Math.max(y, 0), height - 1);
+  cursor.target = null;
+  cursor.gen = -1;
+  cursor.fresh = true;
+  return true;
+}
