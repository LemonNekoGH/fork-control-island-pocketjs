+// Browser physical-pointer bridge. The app owns cursor mode and hit-testing;
+// the host only converts CSS canvas coordinates into the logical viewport.
+function forwardPointer(event) {
+  if (!canvas || typeof globalThis.__pocketPointerMove !== "function") return false;
+  const rect = canvas.getBoundingClientRect();
+  if (rect.width <= 0 || rect.height <= 0) return false;
+  if (event.clientX < rect.left || event.clientX >= rect.right
+    || event.clientY < rect.top || event.clientY >= rect.bottom) return false;
+  const x = ((event.clientX - rect.left) * FB_W) / rect.width;
+  const y = ((event.clientY - rect.top) * FB_H) / rect.height;
+  globalThis.__pocketPointerMove(x, y);
+  return true;
+}
+
+function onPointerMove(event) {
+  forwardPointer(event);
+  if (canvas) canvas.style.cursor = "none";
+}
+
+function onPointerLeave() {
+  if (canvas) canvas.style.cursor = "";
+  globalThis.__pocketPointerLeave?.();
+}
+
+function onPointerDown(event) {
+  if (event.button !== 0) return;
+  forwardPointer(event);
+  held |= BTN.CIRCLE;
+  pointerPressed |= BTN.CIRCLE;
+  canvas?.setPointerCapture?.(event.pointerId);
+  event.preventDefault();
+}
+
+function onPointerUp(event) {
+  if (event.button !== 0) return;
+  if (!forwardPointer(event)) globalThis.__pocketPointerLeave?.();
+  held &= ~BTN.CIRCLE;
+  event.preventDefault();
+}
