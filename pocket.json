{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.moeru.control-island",
  "name": "control-island",
  "title": "Control Island",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "input.cursor"
      ]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "control-island-main",
    "framework": "vue-vapor",
    "viewport": {
      "logical": [480, 272],
      "presentation": "integer-fit"
    }
  }
}
