{
  "name": "control-island-pocketjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "bun node_modules/@pocketjs/framework/scripts/pocket.ts check --target psp --manifest pocket.json --project-root .",
    "capture": "bun run compile && bun scripts/captureStates.ts",
    "compile": "bun node_modules/@pocketjs/framework/scripts/pocket.ts compile --target psp --manifest pocket.json --project-root .",
    "dev": "bun scripts/dev.ts",
    "build:web": "bun scripts/buildWeb.ts",
    "icons": "bun scripts/generateIcons.ts",
    "postinstall": "bun scripts/prepareFramework.ts",
    "preview:web": "bun scripts/previewWeb.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "wasm": "bun node_modules/@pocketjs/framework/scripts/wasm.ts"
  },
  "dependencies": {
    "@pocketjs/framework": "0.6.0",
    "vue": "3.6.0-beta.17"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-typescript": "^7.0.0",
    "babel-preset-solid": "^1.9.0",
    "opentype.js": "^1.3.0",
    "typescript": "5.9.2"
  }
}
